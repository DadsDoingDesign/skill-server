{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/mcp", "destination": "/api/index" },
    { "source": "/mcp/:path*", "destination": "/api/index" },
    { "source": "/healthz", "destination": "/api/index" },
    { "source": "/api/skills", "destination": "/api/index" },
    { "source": "/api/skills/:path*", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
